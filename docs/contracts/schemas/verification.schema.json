{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.semestaislam.com/schemas/v1/verification.schema.json",
  "title": "VerificationRequest",
  "description": "Verification Submission & Status Schema [REPOSITORY VERIFIED]",
  "type": "object",
  "properties": {
    "verificationRequestId": {
      "type": "string",
      "description": "Verification request public tracking identifier"
    },
    "educatorId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "SUBMITTED", "UNDER_REVIEW_LAJNAH", "VERIFIED", "REJECTED", "REVOKED"]
    },
    "ijazahSha256Hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$",
      "description": "Cryptographic SHA-256 fingerprint of the Ijazah document"
    },
    "recommenderEmail": {
      "type": "string",
      "format": "email"
    },
    "recommenderInstitution": {
      "type": "string"
    },
    "ethicsScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "reviewNotes": {
      "type": ["string", "null"]
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["verificationRequestId", "educatorId", "status", "ijazahSha256Hash"],
  "additionalProperties": false,
  "examples": [
    {
      "verificationRequestId": "VR-1700000000000",
      "educatorId": "11111111-1111-1111-1111-111111111111",
      "status": "SUBMITTED",
      "ijazahSha256Hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "recommenderEmail": "recommender@mahad.org",
      "recommenderInstitution": "Ma'had Al-Qur'an Indonesia",
      "ethicsScore": 100,
      "submittedAt": "2026-08-01T00:00:00.000Z"
    }
  ]
}
