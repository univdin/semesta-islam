# SEMESTA ISLAM — Local Development Environment Template
APP_ENV=development
LOCAL_DEMO_MODE=true

# Public Client Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://placeholder-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="placeholder-anon-key-for-local-dev"

# Server-Only Configuration (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY="placeholder-service-role-key-for-local-dev"

# Database Connection Strings (Prisma ORM)
DATABASE_URL="postgresql://postgres:placeholder@localhost:5432/semestaislam?schema=public"
DIRECT_URL="postgresql://postgres:placeholder@localhost:5432/semestaislam?schema=public"

# Upstash Redis Cache & Rate Limiter
UPSTASH_REDIS_REST_URL="https://placeholder-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="placeholder-upstash-token"

# Resend Transactional Email
RESEND_API_KEY="re_placeholder_key"

# Business & Commission Fallback (DECISION-01)
PLATFORM_COMMISSION_PERCENTAGE=0

# Production Bootstrap (idempotent seed: npm run seed:production)
# BOOTSTRAP_FOUNDER_EMAIL=founder@example.com
# BOOTSTRAP_FOUNDER_NAME=Founder SEMESTA ISLAM

# Adapter Selection (validated by src/lib/env.ts)
# MAGIC_LINK_PROVIDER=supabase | resend | mock
# STORAGE_MODE=local | supabase | mock
# OCR_MODE=tesseract | mock
# PAYMENT_PROVIDER=mock | midtrans | xendit
