# ─────────────────────────────────────────────────────────────
# SEMESTA ISLAM / ILMIFY.ID — .gitignore
# Categories: Dependencies · Build · TypeScript · Environment &
# Secrets · Supabase · Vercel · Agent/Skills · Sessions · Logs ·
# Testing & Scratch · Coverage · IDE/OS · DB & Uploads · Docker ·
# Temp
# ─────────────────────────────────────────────────────────────

# 1. Dependencies
node_modules/
.pnp
.pnp.js

# 2. Build outputs
.next/
out/
build/
dist/
.vercel/
.vercel

# 3. TypeScript
*.tsbuildinfo
next-env.d.ts

# 4. Environment & Secrets (NEVER commit real credentials)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local

# 5. Supabase CLI local state
supabase/.temp/
supabase/.branches/
supabase/.git/

# 6. Internal research & private documentation (NOT for public GitHub)
# Canonical specs docs/00_BRD.md..docs/10_ACCEPTANCE_CRITERIA.md stay public.
docs/audit/
docs/implementation/
docs/plan/
docs/productization/
docs/contracts/
docs/integrations/
docs/architecture/
docs/archive/

# 7. Agent / Skills installer runtime artifacts
# (skills-lock.json is tracked; agent/.claude/.agents dirs are transient)
agent/
.claude/
.agents/

# 8. Session transcripts & private logs (must never be published)
session-ses_*.md
*session*.md

# 9. Logs
logs/
*.log
*.test.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 10. Testing, debug & scratch scripts (local repro/QA utilities)
*repro*.mjs
qa-check*.js
scratch/

# 11. Test / coverage output
coverage/
.nyc_output/

# 12. Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# 13. Local databases & uploads
*.sqlite
*.sqlite-journal
public/uploads/
storage/

# 14. Docker
docker-data/

# 15. Temporary files & IDE task artifacts
tmp/
temp/
*.tmp
*.bak
.opencode/
.cursor/
.zed/
