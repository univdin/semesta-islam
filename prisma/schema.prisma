// SEMESTA ISLAM — Canonical Prisma Database Schema
// Governed by docs/03_ERD.md, docs/08_SECURITY_COMPLIANCE.md, & docs/plan/GROWTH_CONSTITUTION.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  LEARNER
  GUARDIAN
  EDUCATOR
  INSTITUTION_ADMIN
  LAJNAH_VERIFIER
  FOUNDER_ADMIN
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW_LAJNAH
  VERIFIED
  REJECTED
  REVOKED
}

enum LearningMethod {
  ONLINE_ZOOM
  PRIVATE_HOME
  GROUP_MAJELIS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LedgerEntryType {
  LEARNER_POINT
  VOUCHER_CREDIT
  FEE_COLLECTION
  COMMISSION_ACCRUAL
  REWARD_TOKEN
}

// 4b. INTERNAL ECONOMY DOMAIN (Economy & Security Closure)

enum EconomicTransactionType {
  EARN
  SPEND
  REVERSAL
  ADJUSTMENT
  FEE_COLLECTION
  COMMISSION_ACCRUAL
}

enum TransactionStatus {
  INITIATED
  AUTHORIZED
  PENDING
  COMPLETED
  FAILED
  EXPIRED
  REFUNDED
  REVERSED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  REFUNDED
  FAILED
}

enum AttributionActorType {
  ORGANIC
  SOCIAL
  CREATOR
  MEMBER
  AMBASSADOR
  AFFILIATE
  PARTNER
  INSTITUTION
}

enum CommissionStatus {
  ACCRUED // Event recorded, pending refund window
  APPROVED // Verified by governance, ready for settlement
  SETTLED // Batch added to payout statement
  PAID // Disbursement completed
  CANCELLED // Rejected due to refund or fraud violation
}

enum XpActionType {
  QUALIFIED_VISIT
  QUALIFIED_REFERRAL_ACTIVATION
  DIAGNOSTIC_COMPLETED
  LEARNING_MODULE_COMPLETED
  COMMUNITY_KHIDMAH
  REVERSAL_FRAUD
}

// 5b. ORGANIZATIONAL DOMAIN (WAVE 0) — Master Execution Directive §8-14

enum OrganizationType {
  INSTITUTION
  COMMUNITY
  PARTNER
}

enum OrganizationRole {
  ORG_OWNER
  ORG_ADMIN
  ORG_MANAGER
  ORG_STAFF
  ORG_MEMBER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum DelegationStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum PermissionScope {
  PLATFORM
  ORGANIZATION
  RESOURCE
  SELF
}

// 5c. NOTIFICATION DOMAIN (WAVE 1)

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_INQUIRED
  VERIFICATION_SUBMITTED
  VERIFICATION_REVIEWED
  VERIFICATION_REJECTED
  MEMBER_INVITED
  DELEGATION_GRANTED
  DELEGATION_REVOKED
  ANNOUNCEMENT
  SYSTEM_ALERT
  COMMENT_ADDED
  COMMENT_REPLY
  QUESTION_ANSWERED
  ANSWER_ACCEPTED
  CONTENT_REPORTED
  CONTENT_MODERATED
}

// 5d. COMMUNITY MODERATION & ENGAGEMENT DOMAIN (Community Knowledge Directive)
// Moderation is soft-delete only: rows are never physically destroyed so audit
// trails and provenance remain intact. Only VISIBLE content is publicly readable.

enum ModerationStatus {
  VISIBLE // Live and publicly readable
  HIDDEN // Soft-hidden; not surfaced in default queries
  REPORTED // Pending review due to user reports
  UNDER_REVIEW // Actively investigated by management
  REMOVED // Soft-removed by moderation (row retained for audit)
  LOCKED // Question/thread locked against further interaction
}

enum CommunityTargetType {
  EDUCATOR_PROFILE
  TOPIC
  QUESTION
  ANSWER
  COMMENT
}

enum VoteType {
  HELPFUL
  AGREE
  ENDORSE
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

// 1. Identity & Profile Domain (ERD §3)
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  phone     String?  @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile      UserProfile?
  roles        RoleAssignment[]
  educator     EducatorProfile?
  learner      LearnerProfile?
  bookings     BookingRequest[] @relation("LearnerBookings")
  ledgers      EconomicLedger[]
  referralCode ReferralCode?
  auditLogs    AuditLog[]       @relation("ActorAuditLogs")

  // Internal Economy Domain
  economicTransactions EconomicTransaction[] @relation("EconomicTransactionActor")
  economicOwned        EconomicTransaction[] @relation("EconomicTransactionOwner")
  payments             Payment[]

  // Shared Infrastructure Extensions
  xpLedgerEntries   XpLedger[]
  reputationProfile ReputationProfile?
  attributions      AttributionRecord[] @relation("AttributorUser")
  commissions       CommissionLedger[]  @relation("AffiliateCommissions")

  // Organizational Domain (WAVE 0 — Membership & Delegation)
  organizations       Organization[]           @relation("OwnedOrganizations")
  memberships         OrganizationMembership[]
  delegationsGranted  Delegation[]             @relation("GrantorDelegations")
  delegationsReceived Delegation[]             @relation("DelegateDelegations")
  notifications       Notification[]
  changelogEntries    ChangelogEntry[]         @relation("ChangelogAuthor")

  // Knowledge Domain (Slice A — claim verifier provenance)
  verificationsReviewed VerificationRequest[] @relation("VerificationVerifiedBy")
  verifiedClaims        KnowledgeClaim[]      @relation("ClaimVerifier")

  // Digital Identity + Platform Configuration provenance
  verifiedDigitalProfiles DigitalProfile[]  @relation("DigitalProfileVerifier")
  platformSettingUpdates  PlatformSetting[] @relation("PlatformSettingUpdater")

  // Community Knowledge Domain (engagement, moderation, provenance)
  communityComments            CommunityComment[]  @relation("CommunityCommentAuthor")
  communityCommentModerations  CommunityComment[]  @relation("CommunityCommentModerator")
  communityVotes               CommunityVote[]     @relation("CommunityVoteVoter")
  communityReports             CommunityReport[]   @relation("CommunityReportReporter")
  communityReportResolutions   CommunityReport[]   @relation("CommunityReportResolver")
  communityQuestions           CommunityQuestion[] @relation("CommunityQuestionAuthor")
  communityQuestionModerations CommunityQuestion[] @relation("CommunityQuestionModerator")
  communityAnswers             CommunityAnswer[]   @relation("CommunityAnswerAuthor")
  communityAnswerAcceptances   CommunityAnswer[]   @relation("CommunityAnswerAcceptor")
  communityAnswerModerations   CommunityAnswer[]   @relation("CommunityAnswerModerator")

  @@map("users")
}

model UserProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  fullName     String   @map("full_name")
  avatarUrl    String?  @map("avatar_url")
  bio          String?
  locationCity String?  @map("location_city")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model RoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("role_assignments")
}

model LearnerProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  guardianName String?  @map("guardian_name")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressReports LearningProgressReport[]

  @@map("learner_profiles")
}

// 2. Educator & Verification Domain (ERD §3.2 & ERD §3.3)
model EducatorProfile {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @unique @map("user_id") @db.Uuid
  titlePrefix     String?            @map("title_prefix")
  titleSuffix     String?            @map("title_suffix")
  institutionName String?            @map("institution_name")
  teachingMethod  LearningMethod     @default(ONLINE_ZOOM) @map("teaching_method")
  ratingAverage   Float              @default(5.0) @map("rating_average")
  reviewsCount    Int                @default(0) @map("reviews_count")
  verifiedStatus  VerificationStatus @default(DRAFT) @map("verified_status")
  slug            String?            @unique
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sanadRecords      SanadRecord[]
  verifications     VerificationRequest[]
  badges            CredentialBadge[]
  courses           CourseCatalog[]
  bookings          BookingRequest[]      @relation("EducatorBookings")
  reviews           ReviewRating[]
  knowledgeClaims   KnowledgeClaim[]
  digitalProfiles   DigitalProfile[]
  CommunityQuestion CommunityQuestion[]

  @@map("educator_profiles")
}

model SanadRecord {
  id               String   @id @default(uuid()) @db.Uuid
  educatorId       String   @map("educator_id") @db.Uuid
  qiraahType       String   @map("qiraah_type")
  chainDescription String   @map("chain_description")
  certificateUrl   String   @map("certificate_url")
  verifiedByLajnah Boolean  @default(false) @map("verified_by_lajnah")
  createdAt        DateTime @default(now()) @map("created_at")

  educator EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)

  @@map("sanad_records")
}

model VerificationRequest {
  id                     String             @id @default(uuid()) @db.Uuid
  educatorId             String             @map("educator_id") @db.Uuid
  status                 VerificationStatus @default(SUBMITTED)
  layer1KtpUrl           String?            @map("layer_1_ktp_url")
  layer2IjazahUrl        String?            @map("layer_2_ijazah_url")
  layer2Sha256Hash       String?            @map("layer_2_sha256_hash")
  layer3RecommenderEmail String?            @map("layer_3_recommender_email")
  layer3TokenConfirmed   Boolean            @default(false) @map("layer_3_token_confirmed")
  layer4EthicsScore      Float              @default(100.0) @map("layer_4_ethics_score")
  reviewNotes            String?            @map("review_notes")
  verifiedById           String?            @map("verified_by_id") @db.Uuid
  verifiedAt             DateTime?          @map("verified_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  educator   EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  verifiedBy User?           @relation("VerificationVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@map("verification_requests")
}

model CredentialBadge {
  id         String   @id @default(uuid()) @db.Uuid
  educatorId String   @map("educator_id") @db.Uuid
  badgeType  String   @map("badge_type")
  issuedAt   DateTime @default(now()) @map("issued_at")

  educator EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)

  @@unique([educatorId, badgeType])
  @@map("credential_badges")
}

// 3. Course Catalog & LMS Domain
model CourseCatalog {
  id          String   @id @default(uuid()) @db.Uuid
  educatorId  String   @map("educator_id") @db.Uuid
  title       String
  category    String
  description String
  duration    String
  createdAt   DateTime @default(now()) @map("created_at")

  educator  EducatorProfile  @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  schedules CourseSchedule[]
  bookings  BookingRequest[]

  @@map("course_catalogs")
}

model CourseSchedule {
  id        String @id @default(uuid()) @db.Uuid
  courseId  String @map("course_id") @db.Uuid
  dayOfWeek String @map("day_of_week")
  startTime String @map("start_time")
  endTime   String @map("end_time")

  course   CourseCatalog    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  bookings BookingRequest[]

  @@map("course_schedules")
}

model LearningProgressReport {
  id               String   @id @default(uuid()) @db.Uuid
  learnerProfileId String   @map("learner_profile_id") @db.Uuid
  educatorName     String   @map("educator_name")
  progressSummary  String   @map("progress_summary")
  talaqqiNotes     String   @map("talaqqi_notes")
  createdAt        DateTime @default(now()) @map("created_at")

  learner LearnerProfile @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)

  @@map("learning_progress_reports")
}

// 4. Booking & Virtual Economic Ledger (ERD §3.5)
model BookingRequest {
  id             String         @id @default(uuid()) @db.Uuid
  learnerUserId  String         @map("learner_user_id") @db.Uuid
  educatorId     String         @map("educator_id") @db.Uuid
  courseId       String?        @map("course_id") @db.Uuid
  scheduleId     String?        @map("schedule_id") @db.Uuid
  learningMethod LearningMethod @default(ONLINE_ZOOM) @map("learning_method")
  status         BookingStatus  @default(PENDING)
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")

  learner     User               @relation("LearnerBookings", fields: [learnerUserId], references: [id], onDelete: Cascade)
  educator    EducatorProfile    @relation("EducatorBookings", fields: [educatorId], references: [id], onDelete: Cascade)
  course      CourseCatalog?     @relation(fields: [courseId], references: [id])
  schedule    CourseSchedule?    @relation(fields: [scheduleId], references: [id])
  reviews     ReviewRating[]
  commissions CommissionLedger[]
  payments    Payment[]

  @@map("booking_requests")
}

model EconomicLedger {
  id             String          @id @default(uuid()) @db.Uuid
  accountOwnerId String          @map("account_owner_id") @db.Uuid
  entryType      LedgerEntryType @map("entry_type")
  amount         Int
  description    String
  transactionId  String?         @map("transaction_id") @db.Uuid
  reversalOfId   String?         @map("reversal_of_id") @db.Uuid
  idempotencyKey String?         @unique @map("idempotency_key")
  createdAt      DateTime        @default(now()) @map("created_at")

  user        User                 @relation(fields: [accountOwnerId], references: [id], onDelete: Cascade)
  transaction EconomicTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  reversalOf  EconomicLedger?      @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals   EconomicLedger[]     @relation("LedgerReversal")

  @@index([accountOwnerId])
  @@index([transactionId])
  @@map("economic_ledgers")
}

// Internal economy transaction — the lifecycle/orchestration record.
// EconomicLedger remains the canonical append-only source of truth; balance is
// ALWAYS a projection (see src/lib/economy/service.ts).
model EconomicTransaction {
  id             String                  @id @default(uuid()) @db.Uuid
  type           EconomicTransactionType @map("type")
  status         TransactionStatus       @default(INITIATED)
  actorUserId    String                  @map("actor_user_id") @db.Uuid
  accountOwnerId String                  @map("account_owner_id") @db.Uuid
  amount         Int
  currency       String                  @default("POINT")
  idempotencyKey String?                 @unique @map("idempotency_key")
  source         String
  reference      String?
  reason         String?
  reversalOfId   String?                 @unique @map("reversal_of_id") @db.Uuid
  organizationId String?                 @map("organization_id") @db.Uuid
  expiresAt      DateTime?               @map("expires_at")
  completedAt    DateTime?               @map("completed_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  actor        User                  @relation("EconomicTransactionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  accountOwner User                  @relation("EconomicTransactionOwner", fields: [accountOwnerId], references: [id], onDelete: Restrict)
  reversalOf   EconomicTransaction?  @relation("EconomicReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals    EconomicTransaction[] @relation("EconomicReversal")
  entries      EconomicLedger[]

  @@index([accountOwnerId, status])
  @@index([actorUserId])
  @@index([organizationId])
  @@map("economic_transactions")
}

// Minimal external payment boundary (blueprint §28). This is the provider-side
// record only — it is NEVER the source of truth for internal balance.
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  bookingId      String        @map("booking_id") @db.Uuid
  learnerUserId  String        @map("learner_user_id") @db.Uuid
  amount         Int
  currency       String        @default("IDR")
  provider       String        @default("SIMULATED_INTERNAL")
  externalId     String?       @unique @map("external_id")
  status         PaymentStatus @default(PENDING)
  idempotencyKey String?       @unique @map("idempotency_key")
  rawPayload     Json?         @default("{}") @map("raw_payload")
  paidAt         DateTime?     @map("paid_at")
  refundedAt     DateTime?     @map("refunded_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  booking BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  learner User           @relation(fields: [learnerUserId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@map("payments")
}

model ReferralCode {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  code       String   @unique
  clickCount Int      @default(0) @map("click_count")
  createdAt  DateTime @default(now()) @map("created_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversions ReferralConversion[]

  @@map("referral_codes")
}

model ReferralConversion {
  id             String   @id @default(uuid()) @db.Uuid
  referralCodeId String   @map("referral_code_id") @db.Uuid
  refereeUserId  String   @map("referee_user_id") @db.Uuid
  pointsAwarded  Int      @default(50) @map("points_awarded")
  createdAt      DateTime @default(now()) @map("created_at")

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  @@map("referral_conversions")
}

model ReviewRating {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @map("booking_id") @db.Uuid
  educatorId String   @map("educator_id") @db.Uuid
  rating     Int
  comment    String
  createdAt  DateTime @default(now()) @map("created_at")

  booking  BookingRequest  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  educator EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)

  @@map("review_ratings")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String   @map("actor_user_id") @db.Uuid
  actionType     String   @map("action_type")
  entityAffected String   @map("entity_affected")
  entityId       String?  @map("entity_id")
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  actor User @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([entityAffected, entityId])
  @@map("audit_logs")
}

// 5. SHARED GROWTH INFRASTRUCTURE MODELS (LOCKED BASELINE)

model XpLedger {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  eventId        String       @map("event_id")
  idempotencyKey String       @unique @map("idempotency_key")
  amount         Int
  actionType     XpActionType @map("action_type")
  source         String
  reference      String?
  createdAt      DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("xp_ledgers")
}

model ReputationProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  consistencyScore  Float    @default(100.0) @map("consistency_score")
  contributionScore Float    @default(0.0) @map("contribution_score")
  integrityScore    Float    @default(100.0) @map("integrity_score")
  derivedStanding   String   @default("CONTRIBUTOR_INITIATE") @map("derived_standing")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reputation_profiles")
}

model AttributionRecord {
  id           String               @id @default(uuid()) @db.Uuid
  actorUserId  String?              @map("actor_user_id") @db.Uuid
  actorType    AttributionActorType @map("actor_type")
  landingPath  String               @map("landing_path")
  utmSource    String?              @map("utm_source")
  utmMedium    String?              @map("utm_medium")
  utmCampaign  String?              @map("utm_campaign")
  campaignCode String?              @map("campaign_code")
  fraudSignals Json?                @default("{}") @map("fraud_signals")
  createdAt    DateTime             @default(now()) @map("created_at")

  actorUser User? @relation("AttributorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("attribution_records")
}

model CampaignRecord {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  code         String    @unique
  campaignType String    @map("campaign_type") // SYIAR, RAMADAN, CREATOR, AMBASSADOR, AFFILIATE, SCHOOL
  isActive     Boolean   @default(true) @map("is_active")
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("campaign_records")
}

model CommissionLedger {
  id             String           @id @default(uuid()) @db.Uuid
  affiliateId    String           @map("affiliate_id") @db.Uuid
  bookingId      String?          @map("booking_id") @db.Uuid
  accruedAmount  Float            @map("accrued_amount")
  approvedAmount Float?           @map("approved_amount")
  status         CommissionStatus @default(ACCRUED)
  payoutId       String?          @map("payout_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  affiliate User            @relation("AffiliateCommissions", fields: [affiliateId], references: [id], onDelete: Cascade)
  booking   BookingRequest? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@map("commission_ledgers")
}

// 6. ORGANIZATIONAL DOMAIN MODELS (WAVE 0)

model Organization {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  type        OrganizationType @default(INSTITUTION)
  status      String           @default("ACTIVE")
  ownerUserId String           @map("owner_user_id") @db.Uuid
  metadata    Json?            @default("{}")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  owner           User                     @relation("OwnedOrganizations", fields: [ownerUserId], references: [id])
  memberships     OrganizationMembership[]
  delegations     Delegation[]
  rolePermissions RolePermission[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrganizationRole @default(ORG_MEMBER)
  status         MembershipStatus @default(INVITED)
  joinedAt       DateTime         @default(now()) @map("joined_at")
  expiresAt      DateTime?        @map("expires_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_memberships")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  category    String   @default("general")
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id             String           @id @default(uuid()) @db.Uuid
  permissionId   String           @map("permission_id") @db.Uuid
  role           OrganizationRole
  scope          PermissionScope  @default(ORGANIZATION)
  organizationId String?          @map("organization_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")

  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([permissionId, role, organizationId])
  @@map("role_permissions")
}

model Delegation {
  id             String           @id @default(uuid()) @db.Uuid
  grantorUserId  String           @map("grantor_user_id") @db.Uuid
  delegateUserId String           @map("delegate_user_id") @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  capabilities   Json             @default("[]")
  status         DelegationStatus @default(ACTIVE)
  startsAt       DateTime         @default(now()) @map("starts_at")
  expiresAt      DateTime?        @map("expires_at")
  reason         String?
  createdAt      DateTime         @default(now()) @map("created_at")
  revokedAt      DateTime?        @map("revoked_at")
  revokedBy      String?          @map("revoked_by") @db.Uuid

  grantor      User          @relation("GrantorDelegations", fields: [grantorUserId], references: [id])
  delegate     User          @relation("DelegateDelegations", fields: [delegateUserId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([delegateUserId])
  @@index([grantorUserId])
  @@map("delegations")
}

// 7. NOTIFICATION & CHANGELOG MODELS

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String?
  readAt    DateTime?        @map("read_at")
  metadata  Json?            @default("{}")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model ChangelogEntry {
  id           String    @id @default(uuid()) @db.Uuid
  title        String
  slug         String    @unique
  summary      String?
  body         String?
  version      String?
  audience     String    @default("public")
  status       String    @default("DRAFT")
  authorUserId String    @map("author_user_id") @db.Uuid
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  author User @relation("ChangelogAuthor", fields: [authorUserId], references: [id])

  @@map("changelog_entries")
}

// 8. INTEGRATION / OPERATIONS MODELS (Google Cloud & Workspace Directive §9, §20, §24)

model IntegrationHealth {
  id            String    @id @default(uuid()) @db.Uuid
  provider      String    @unique @map("provider")
  status        String    @default("DISCONNECTED")
  lastSuccessAt DateTime? @map("last_success_at")
  lastFailureAt DateTime? @map("last_failure_at")
  errorCode     String?   @map("error_code")
  errorMessage  String?   @map("error_message")
  latencyMs     Int?      @map("latency_ms")
  quotaStatus   String?   @map("quota_status")
  metadata      Json?     @default("{}")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("integration_health")
}

model BackupRecord {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @map("provider")
  status      String    @default("CREATED")
  manifest    Json?     @default("{}")
  backupSize  Int?      @map("backup_size")
  checksum    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  verifiedAt  DateTime? @map("verified_at")
  completedAt DateTime? @map("completed_at")

  @@index([provider, createdAt])
  @@map("backup_records")
}

model IntegrationJob {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @map("provider")
  operation   String    @map("operation")
  status      String    @default("PENDING")
  attempt     Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?   @map("last_error")
  payload     Json?     @default("{}")
  result      Json?     @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([provider, status])
  @@map("integration_jobs")
}

// 9. KNOWLEDGE DOMAIN (Slice A — Claim / Source / Evidence provenance)
// Governed by the Knowledge/Trust foundation slice. Postgres remains the system
// of record; a graph projection may consume these relations later.

enum ClaimStatus {
  DRAFT
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum ClaimPredicate {
  GRADUATED_FROM
  HOLDS_CREDENTIAL
  HAS_SANAD_IN
  SPECIALIZES_IN
  AFFILIATED_WITH
  AUTHORED
}

// Origin of a claim (certificate, publication, website, biography).
model Source {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  url         String?
  publisher   String?
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  evidences Evidence[]
  claims    KnowledgeClaim[]

  @@map("sources")
}

// A specific artifact supporting a claim (document URL + optional SHA-256).
model Evidence {
  id          String   @id @default(uuid()) @db.Uuid
  sourceId    String?  @map("source_id") @db.Uuid
  url         String
  sha256      String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  source Source?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  claims KnowledgeClaim[]

  @@index([sourceId])
  @@map("evidences")
}

// A factual knowledge claim about an educator, with source/evidence provenance
// and verifier attribution. Claims are NOT authoritative until VERIFIED.
model KnowledgeClaim {
  id              String         @id @default(uuid()) @db.Uuid
  educatorId      String         @map("educator_id") @db.Uuid
  predicate       ClaimPredicate
  objectText      String         @map("object_text")
  objectType      String?        @map("object_type")
  status          ClaimStatus    @default(UNVERIFIED)
  confidence      Float?
  sourceId        String?        @map("source_id") @db.Uuid
  evidenceId      String?        @map("evidence_id") @db.Uuid
  topicId         String?        @map("topic_id") @db.Uuid
  verifiedById    String?        @map("verified_by_id") @db.Uuid
  verifiedAt      DateTime?      @map("verified_at")
  sourceCommentId String?        @map("source_comment_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  educator      EducatorProfile   @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  source        Source?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  evidence      Evidence?         @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  verifiedBy    User?             @relation("ClaimVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  topic         Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sourceComment CommunityComment? @relation("ClaimSourceComment", fields: [sourceCommentId], references: [id], onDelete: SetNull)

  @@index([educatorId, status])
  @@index([predicate])
  @@index([topicId])
  @@map("knowledge_claims")
}

// 10. TAXONOMY / TOPIC DOMAIN (EXP-03)
// Canonical topic entity. Topics are NOT arbitrary strings; they are governed
// taxonomy nodes with slugs, parent hierarchy, aliases and publish state.
// Educator ↔ Topic edges are expressed via VERIFIED SPECIALIZES_IN claims
// referencing this entity (KnowledgeClaim.topicId).

enum TopicStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Topic {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  slug        String      @unique
  description String?
  parentId    String?     @map("parent_id") @db.Uuid
  status      TopicStatus @default(DRAFT) @map("status")
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  parent            Topic?              @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Topic[]             @relation("TopicHierarchy")
  aliases           TopicAlias[]
  claims            KnowledgeClaim[]
  CommunityQuestion CommunityQuestion[]

  @@index([status, sortOrder])
  @@map("topics")
}

// A searchable/alias name for a Topic (canonical alias seam). Aliases are
// editorial synonyms, not separate entities.
model TopicAlias {
  id      String @id @default(uuid()) @db.Uuid
  topicId String @map("topic_id") @db.Uuid
  alias   String @unique

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@map("topic_aliases")
}

// 11. DIGITAL IDENTITY DOMAIN (Phase H — external platform profiles)
// External identity is never inferred from name/avatar similarity. An
// educator self-declares a profile (SELF_DECLARED) and management verifies it
// (VERIFIED). Only VERIFIED external profiles may become authoritative
// `sameAs` references in public structured data.

enum DigitalPlatform {
  WEBSITE
  YOUTUBE
  INSTAGRAM
  TIKTOK
  X
  FACEBOOK
  OTHER
}

enum DigitalProfileStatus {
  SELF_DECLARED
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

model DigitalProfile {
  id           String               @id @default(uuid()) @db.Uuid
  educatorId   String               @map("educator_id") @db.Uuid
  platform     DigitalPlatform      @map("platform")
  url          String               @map("url")
  handle       String?
  status       DigitalProfileStatus @default(SELF_DECLARED) @map("status")
  verifiedById String?              @map("verified_by_id") @db.Uuid
  verifiedAt   DateTime?            @map("verified_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  educator   EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  verifiedBy User?           @relation("DigitalProfileVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([educatorId, platform, url])
  @@index([status])
  @@map("digital_profiles")
}

// 12. PLATFORM CONFIGURATION DOMAIN (Phase B — founder control plane)
// Typed persistent key/value runtime configuration. This holds PRODUCT
// configuration (feature flags, publishing policy, integration status) that
// founders/management mutate at runtime. It NEVER holds secrets — secrets stay
// in environment variables and are never founder-editable via this surface.

model PlatformSetting {
  key         String   @id
  value       String
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("PlatformSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

// 13. COMMUNITY KNOWLEDGE DOMAIN (Community Knowledge + Trust Directive)
// UGC is NEVER authoritative. Trust signals derived from this domain are
// COMMUNITY_SIGNAL / COMMUNITY_ENDORSED — never VERIFIED. Only the existing
// verification pipeline can produce VERIFIED state. Rows are soft-deleted via
// ModerationStatus so every moderation decision stays auditable.

// A comment/reply/correction on any community target (educator profile, topic,
// question, answer, or another comment).
model CommunityComment {
  id             String              @id @default(uuid()) @db.Uuid
  authorId       String              @map("author_id") @db.Uuid
  targetType     CommunityTargetType @map("target_type")
  targetId       String              @map("target_id") @db.Uuid
  parentId       String?             @map("parent_id") @db.Uuid
  body           String              @map("body")
  status         ModerationStatus    @default(VISIBLE) @map("status")
  isCorrection   Boolean             @default(false) @map("is_correction")
  correctionNote String?             @map("correction_note")
  moderatedById  String?             @map("moderated_by_id") @db.Uuid
  moderatedAt    DateTime?           @map("moderated_at")
  editedAt       DateTime?           @map("edited_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  author            User               @relation("CommunityCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent            CommunityComment?  @relation("CommentReply", fields: [parentId], references: [id], onDelete: SetNull)
  replies           CommunityComment[] @relation("CommentReply")
  moderatedBy       User?              @relation("CommunityCommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  originatingClaims KnowledgeClaim[]   @relation("ClaimSourceComment")

  @@index([targetType, targetId, status])
  @@index([authorId])
  @@index([status, createdAt])
  @@map("community_comments")
}

// An up/down-style signal cast by a member against a community target.
// One member may hold at most one vote per (target, type) combination.
model CommunityVote {
  id         String              @id @default(uuid()) @db.Uuid
  voterId    String              @map("voter_id") @db.Uuid
  targetType CommunityTargetType @map("target_type")
  targetId   String              @map("target_id") @db.Uuid
  voteType   VoteType            @map("vote_type")
  createdAt  DateTime            @default(now()) @map("created_at")

  voter User @relation("CommunityVoteVoter", fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([voterId, targetType, targetId, voteType])
  @@index([targetType, targetId])
  @@map("community_votes")
}

// A user-initiated moderation flag. Deduplicated per reporter/target so the
// same member cannot spam-flag the same content repeatedly.
model CommunityReport {
  id           String              @id @default(uuid()) @db.Uuid
  reporterId   String              @map("reporter_id") @db.Uuid
  targetType   CommunityTargetType @map("target_type")
  targetId     String              @map("target_id") @db.Uuid
  reason       String              @map("reason")
  status       ReportStatus        @default(OPEN) @map("status")
  resolution   String?             @map("resolution")
  resolvedById String?             @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?           @map("resolved_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  reporter   User  @relation("CommunityReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("CommunityReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([status])
  @@map("community_reports")
}

// A community Q&A question. Anchored to an educator and/or topic so Q&A can
// be surfaced contextually. An accepted answer is COMMUNITY_SIGNAL only — it
// NEVER upgrades content to VERIFIED.
model CommunityQuestion {
  id            String           @id @default(uuid()) @db.Uuid
  authorId      String           @map("author_id") @db.Uuid
  topicId       String?          @map("topic_id") @db.Uuid
  educatorId    String?          @map("educator_id") @db.Uuid
  title         String           @map("title")
  body          String           @map("body")
  status        ModerationStatus @default(VISIBLE) @map("status")
  moderatedById String?          @map("moderated_by_id") @db.Uuid
  moderatedAt   DateTime?        @map("moderated_at")
  editedAt      DateTime?        @map("edited_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  author      User              @relation("CommunityQuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  topic       Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  educator    EducatorProfile?  @relation(fields: [educatorId], references: [id], onDelete: SetNull)
  moderatedBy User?             @relation("CommunityQuestionModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  answers     CommunityAnswer[]

  @@index([status, createdAt])
  @@index([topicId, status])
  @@index([educatorId, status])
  @@map("community_questions")
}

// An answer to a CommunityQuestion. `acceptedAt` marks the asker's accepted
// answer (COMMUNITY_SIGNAL). Only the question author can accept/change it.
model CommunityAnswer {
  id            String           @id @default(uuid()) @db.Uuid
  questionId    String           @map("question_id") @db.Uuid
  authorId      String           @map("author_id") @db.Uuid
  body          String           @map("body")
  status        ModerationStatus @default(VISIBLE) @map("status")
  acceptedAt    DateTime?        @map("accepted_at")
  acceptedById  String?          @map("accepted_by_id") @db.Uuid
  moderatedById String?          @map("moderated_by_id") @db.Uuid
  moderatedAt   DateTime?        @map("moderated_at")
  editedAt      DateTime?        @map("edited_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  question    CommunityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author      User              @relation("CommunityAnswerAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  acceptedBy  User?             @relation("CommunityAnswerAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  moderatedBy User?             @relation("CommunityAnswerModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([questionId, status])
  @@index([authorId])
  @@map("community_answers")
}
