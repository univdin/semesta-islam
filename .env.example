# Environment mode
# APP_ENV: development | staging | production
APP_ENV=development
# LOCAL_DEMO_MODE: true enables local simulation identities (@localhost.test)
LOCAL_DEMO_MODE=false

# Public Client Configuration
# NEXT_PUBLIC_SITE_URL=https://ilmify.id (canonical public domain)
NEXT_PUBLIC_SITE_URL=https://ilmify.id

# Supabase Environment Variables (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Direct Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Upstash Redis Environment Variables (Free Tier)
# Modern Vercel KV naming (used by src/lib/rate-limit.ts)
KV_REST_API_URL=https://your-kv.upstash.io
KV_REST_API_TOKEN=your-kv-token
KV_REST_API_READ_ONLY_TOKEN=your-kv-read-only-token
# Legacy alias (kept for compatibility)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Resend Email Transaksional (Free Tier)
# TODO: replace with a real Resend API key (create at https://resend.com/api-keys)
RESEND_API_KEY=re_123456789
RESEND_EMAIL_DOMAIN=ilmify.id

# Browserbase (browser automation for e2e verification)
BROWSERBASE_API_KEY=bb_live_xxxxxxxx
BROWSERBASE_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Business & Commission Fallback (DECISION-01)
PLATFORM_COMMISSION_PERCENTAGE=0

# Production Bootstrap (idempotent seed: npm run seed:production)
# BOOTSTRAP_FOUNDER_EMAIL=founder@example.com
# BOOTSTRAP_FOUNDER_NAME=Founder SEMESTA ISLAM

# Adapter Selection (validated by src/lib/env.ts)
# MAGIC_LINK_PROVIDER=supabase | resend | mock
# STORAGE_MODE=local | supabase | mock
# OCR_MODE=tesseract | mock
# PAYMENT_PROVIDER=mock | midtrans | xendit
